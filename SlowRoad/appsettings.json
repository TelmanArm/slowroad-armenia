{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Admin login throttle. PermitLimit is attempts per client IP per
  // WindowMinutes before /Admin/Login stops answering; MaxFailedAttempts is
  // failures against one account before it locks for LockoutMinutes.
  "Security": {
    "Login": {
      "PermitLimit": 10,
      "WindowMinutes": 5,
      "MaxFailedAttempts": 10,
      "LockoutMinutes": 1
    }
  },
  "Analytics": {
    "MeasurementId": "G-W50M869RP9"
  }
}
