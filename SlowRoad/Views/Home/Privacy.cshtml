@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["Description"] = "Privacy policy for The Slow Road Armenia travel guide.";
}

<section class="page-header">
    <div class="container container--narrow">
        <span class="eyebrow">Legal</span>
        <h1>@ViewData["Title"]</h1>
        <p>Last updated: September 2026</p>
    </div>
</section>

<section class="section">
    <div class="container container--narrow prose">
        <p>The Slow Road Armenia is a static information site. We keep things simple, and that includes your privacy.</p>

        <h2>What we collect</h2>
        <p>Nothing. This site has no accounts, no contact forms, no comments and no analytics scripts. We do not set cookies.</p>

        <h2>Email</h2>
        <p>If you write to us at <a href="mailto:hello@slowroadarmenia.com">hello@slowroadarmenia.com</a>, we use your message only to reply to you. We never share your address.</p>

        <h2>External links</h2>
        <p>Links to other websites (for example official visa or exchange-rate pages) are provided for convenience. Those sites have their own privacy policies.</p>

        <h2>Hosting</h2>
        <p>Like any web server, our host may keep standard technical logs (such as IP address and pages requested) for security and troubleshooting.</p>

        <p><a asp-controller="Home" asp-action="Index">&larr; Back to the guide</a></p>
    </div>
</section>
