@model PlaceCardViewModel
@* Shared destination card. Images are served by PhotosController at
   /photos/{photoId}/{width}. The title link is stretched over the whole card
   (see .card__link in site.css), so clicking anywhere opens the detail page. *@
<article class="card">
    <figure><img src="/photos/@Model.PhotoId/700"
             srcset="/photos/@Model.PhotoId/700 700w, /photos/@Model.PhotoId/1400 1400w"
             sizes="(min-width: 1024px) 351px, (min-width: 768px) 46vw, 92vw"
             width="1584" height="990" loading="lazy" decoding="async"
             alt="@Model.Alt" /></figure>
    <div class="card__body">
        <span class="card__region">@Model.Region</span>
        @if (!string.IsNullOrEmpty(Model.Slug))
        {
            <h3><a class="card__link" asp-controller="Destinations" asp-action="Details" asp-route-slug="@Model.Slug">@Model.Name</a></h3>
        }
        else
        {
            <h3>@Model.Name</h3>
        }
        <p>@Model.Body</p>
    </div>
</article>
