@model Section
@* ===== Home: intro + featured destinations (from the database) ===== *@
<section class="section" id="featured">
    <div class="container">
        <div class="block-head">
            <div class="section-head">
                <span class="eyebrow">@Model.Eyebrow</span>
                <h2>@Model.Title</h2>
                <p class="lead">@Model.Lead</p>
            </div>
            <a class="block-head__link" href="#destinations">See all destinations &rarr;</a>
        </div>

        <div class="card-grid">
            @foreach (var si in Model.Items)
            {
                var item = si.Item;
                var card = PlaceCardViewModel.From(item, item.ShortDescription ?? item.Description);
                <partial name="_PlaceCard" model="card" />
            }
        </div>
    </div>
</section>
