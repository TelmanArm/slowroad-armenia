@* ===== Home: full-width hero (photo + scrim; styles in site.css → .hero) ===== *@
<section class="hero" id="home">
    <img class="hero__bg"
         src="~/images/hero-1584.webp"
         srcset="/images/hero-900.webp 900w, /images/hero-1584.webp 1584w"
         sizes="100vw"
         width="1584" height="990"
         fetchpriority="high" decoding="async" alt="" />
    <div class="hero__content">
        <span class="eyebrow">A slow travel guide</span>
        <h1>Discover Armenia</h1>
        <p>
            The land of ancient monasteries, mountain roads and apricots — with a
            6,000-year-old wine tradition. Take it slowly; you will see more.
        </p>
        <div class="hero__actions">
            <a class="btn btn--primary" href="#destinations">Explore destinations</a>
            <a class="btn btn--ghost" href="#plan">Plan your trip</a>
        </div>
    </div>
</section>
