@model Section
@* ===== Destinations: full card grid of top sites (from the database) ===== *@
<section class="section" id="destinations">
    <div class="container">
        <div class="section-head">
            <span class="eyebrow">@Model.Eyebrow</span>
            <h2>@Model.Title</h2>
            <p class="lead">@Model.Lead</p>
        </div>

        <div class="card-grid">
            @foreach (var si in Model.Items)
            {
                var item = si.Item;
                var photo = item.Photos.FirstOrDefault();
                var card = new PlaceCardViewModel
                {
                    PhotoId = photo?.Id ?? 0,
                    Alt = photo?.Alt,
                    Region = item.Region,
                    Name = item.Name,
                    Body = item.Description,
                };
                <partial name="_PlaceCard" model="card" />
            }
        </div>
    </div>
</section>
