@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="page-header">
    <div class="container container--narrow">
        <span class="eyebrow">Something went wrong</span>
        <h1>An error occurred while processing your request.</h1>
    </div>
</section>

<section class="section">
    <div class="container container--narrow prose">
        @if (Model.ShowRequestId)
        {
            <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
        <p>Please try again, or head back to the guide.</p>
        <p><a class="btn btn--outline" asp-controller="Home" asp-action="Index">Back to home</a></p>
    </div>
</section>
