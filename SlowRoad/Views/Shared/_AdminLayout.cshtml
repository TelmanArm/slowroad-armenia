<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Keep admin pages out of search engine indexes -->
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] – Admin</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <!-- Font: Inter from Google Fonts (system font stack is the fallback, see site.css) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <!-- One shared stylesheet for the whole site -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- No header/nav/footer here: admin pages get a bare, centred layout -->
    <div class="admin-shell">
        <div class="admin-card @ViewData["CardClass"]">
            @RenderBody()
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>