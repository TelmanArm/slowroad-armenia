<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – The Slow Road Armenia</title>
    <meta name="description" content="@(ViewData["Description"] ?? "A simple, free travel guide to Armenia for first-time visitors: destinations, planning tips, food and culture.")" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <!-- Font: Inter from Google Fonts (system font stack is the fallback, see site.css) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <!-- One shared stylesheet for the whole site -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="page">
    <a class="skip-link" href="#main">Skip to content</a>

    <!-- ===== Header / sticky navigation ===== -->
    <header class="site-header">
        <nav class="container nav" aria-label="Main navigation">
            <!-- Mobile menu uses the CSS "checkbox hack": no JavaScript.
                 The label below toggles this hidden checkbox; site.css shows
                 .nav-links when it is checked. -->
            <input type="checkbox" id="nav-toggle" class="nav-toggle sr-only" />

            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand__mark" aria-hidden="true"></span>
                The Slow Road Armenia
            </a>

            <label for="nav-toggle" class="nav-burger" aria-label="Toggle navigation menu">
                <span></span><span></span><span></span>
            </label>

            <ul class="nav-links">
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Home" asp-action="Index" asp-fragment="destinations">Destinations</a></li>
                <li><a asp-controller="Home" asp-action="Index" asp-fragment="plan">Plan Your Trip</a></li>
                <li><a asp-controller="Home" asp-action="Index" asp-fragment="food-culture">Food &amp; Culture</a></li>
                <li><a asp-controller="Home" asp-action="Index" asp-fragment="about">About</a></li>
                <li class="nav-cta"><a asp-controller="Home" asp-action="Index" asp-fragment="plan">Start planning</a></li>
            </ul>
        </nav>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <!-- ===== Footer ===== -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <a class="brand" asp-controller="Home" asp-action="Index">
                        <span class="brand__mark" aria-hidden="true"></span>
                        The Slow Road Armenia
                    </a>
                    <p>
                        A free, simple guide for first-time visitors to Armenia — ancient monasteries,
                        mountain roads, and a table that is always set for one more guest.
                    </p>
                </div>
                <div>
                    <h3>Explore</h3>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="destinations">Destinations</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="food-culture">Food &amp; Culture</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="about">About this site</a></li>
                    </ul>
                </div>
                <div>
                    <h3>Plan</h3>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="best-time">Best time to visit</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="getting-there">Getting there</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="visa">Visa &amp; currency</a></li>
                    </ul>
                </div>
                <div>
                    <h3>Contact</h3>
                    <ul>
                        <li><a href="mailto:hello@slowroadarmenia.com">hello@slowroadarmenia.com</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; 2026 The Slow Road Armenia. All rights reserved.</span>
                <span>Made with plain HTML &amp; CSS. Photos: replace placeholders with your own or free Unsplash/Pexels images.</span>
            </div>
        </div>
    </footer>
</div>
</body>
</html>
