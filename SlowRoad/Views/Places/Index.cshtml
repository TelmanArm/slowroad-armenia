@model List<Place>
@{
    ViewData["Title"] = "Places";
    ViewData["CardClass"] = "admin-card--wide";
}

<h1>Places</h1>

<p>
    <a class="btn" asp-action="Create">+ New place</a>
    <a class="admin-back" asp-controller="Admin" asp-action="Index">← Dashboard</a>
</p>

@if (Model.Count == 0)
{
    <p>No places yet.</p>
}
else
{
    <table class="admin-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Region</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Region</td>
                    <td>
                        <a asp-controller="Destinations" asp-action="Details" asp-route-slug="@p.Slug" target="_blank">View</a>
                        <a asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                        <a asp-action="Delete" asp-route-id="@p.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
